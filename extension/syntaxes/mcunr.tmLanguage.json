{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "MCU-NR",
  "scopeName": "source.mcunr",
  "patterns": [
    { "include": "#comments" },
    { "include": "#includes" },
    { "include": "#sectionMarkers" },
    { "include": "#cards" },
    { "include": "#bodies" },
    { "include": "#numbers" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "match": "^\\*.*$", "name": "comment.line.mcunr" },
        { "match": "^C=.*$", "name": "comment.line.mcunr" },
        { "match": ";.*$", "name": "comment.line.mcunr" }
      ]
    },
    "includes": {
      "patterns": [
        {
          "match": "^\\s*#include\\s+(?:<([^>]+)>|(\\S+))",
          "name": "meta.preprocessor.include.mcunr",
          "captures": {
            "1": { "name": "string.unquoted.include.path.mcunr" },
            "2": { "name": "string.unquoted.include.path.mcunr" }
          }
        }
      ]
    },
    "sectionMarkers": {
      "patterns": [
        {
          "comment": "Начало фрагмента варианта (PIN, HEAD, CAL, …) — см. FRAGMENT_STARTERS в mcu-schema/keywords.ts",
          "match": "^(PIN|HEAD|CONT|MIR|SRCD|SRC|SPNT|RGS|REGD|REG|BRGD|BRG|TRJD|TRJ|NTOT|NAMV|NAMVAR|CALD|CAL|BURD|BURN|BURNUP)\\b",
          "name": "markup.heading.section.start.mcunr"
        },
        {
          "comment": "Конец фрагмента",
          "match": "^(FINISH)\\b",
          "name": "markup.heading.section.end.mcunr"
        }
      ]
    },
    "cards": {
      "patterns": [
        {
          "match": "^(ABSZ|ACEPT|ACERR|ACTI|ADDF|ADDZ|ANGLEN|BAL|BCRIT|BETA|BMAX|BOUN|BRG|BRGD|BUCL|BURALL|BURD|BURN|BURNUP|CAL|CALD|CELL|CLEF|CLEZ|CNTAND|CNTU|CODE|COLI|CONT|CONTEN|CPM|CPMEND|DEF|DEFPRN|DELAY|DELN|DELTAB|DOS|DPNT|DPOW|DRING|DSTP|DTZM|DTZML|EABS|ECEL|ECPO|ECUP|ECUT|EDIS|EGEL|EGPH|EGRC|ELEC|ELEM|EMES|END|ENDL|ENDXCL|ENERG|ENERGY|ENSO|EOPT|EPRO|EPSM|EQU|ESET|FINAL|FINDEN|FINISH|FINTAB|FISP|FISZ|FISZON|FIXED|FLUX|FUNC|GLIB|GRBL|GRBU|HEAD|HGRI|HPC|ICE|ICENOT|INPE|INPM|INPO|INRA|ISTR|IWPHN|KEFF|LATT|LCELL|LIFE|LIST|LISTEL|LOBJ|MATFIL|MATPRN|MATR|MATREP|MATWGT|MAXS|MAXSER|MCUR|MDIS|MDOS|MELEN|MFLU|MIR|MIXG|MMES|MNEN|MOM4|MPHEN|MPRO|MRCT|MSMT|NAMV|NAMVAR|NBAT|NBATCH|NENRG|NET|NEUT|NFUNC|NOBJ|NORM|NPRI|NPRINT|NPS|NRAN|NREG|NRET|NSKI|NTOT|NUCOFF|OCUR|ODOS|OELEN|OFLU|ONEN|OPHEN|ORCT|OSMT|PARA|PARM|PBUR|PENRG|PERC|PFUNC|PHOT|PIN|PTYPE|POWE|POWER|POWZ|PRISOU|PROB|PSGR|PSIN|RADS|RCT|RCZD|REACT|REG|REGD|REPER|RGRI|RGS|ROOT|RPC|SANG|SERIES|SET|SETT|SFLUX|SHORT|SHOW|SIDEN|SINOT|SIPRN|SIZI|SNAM|SOURCE|SPEC|SPECTR|SPNT|SRC|SRCD|STEP|STOP|SUMZ|SUMZON|TDAY|TEMPR|THOU|TIMP|TMIN|TRANSF|TRJ|TRJD|TSEC|TTYPE|TYEA|TYPE|V01|VOL|WOBJ|WPHO|WTOB|WWEN|XYZ0|ZCUR|ZDOS|ZELCH|ZELEN|ZFLU|ZNEN|ZONP|ZONPRI|ZPHEN|ZPOCH|ZPOEN|ZRCT|ZRTB|ZSMT)\\b",
          "name": "keyword.control.mcunr"
        }
      ]
    },
    "bodies": {
      "patterns": [
        {
          "match": "\\b(SPH|RCC|RPP|RCZ|HEX|HEXX|HEXY|BOX|PLG|PLX|PLY|PLZ|SBOX|SHEX|ARB|QUAD|HEXG|UPOLY)\\b",
          "name": "entity.name.type.mcunr"
        }
      ]
    },
    "numbers": {
      "patterns": [
        { "match": "[+-]?\\d+\\.?\\d*([Ee][+-]?\\d+)?", "name": "constant.numeric.mcunr" }
      ]
    },
    "identifiers": {
      "patterns": [
        { "match": "[A-Za-z][A-Za-z0-9]{0,5}", "name": "variable.other.mcunr" }
      ]
    }
  }
}
